{
  "name": "@finopsbricks/fob-lgr",
  "version": "0.3.0",
  "description": "Ledger app client + fob-lgr CLI (2-in-1). Import the client in workers and agents, or use the CLI.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fob-lgr": "./bin/cli.js"
  },
  "files": [
    "bin",
    "src/**/*.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecheck": "tsc -p jsconfig.json",
    "typecheck:watch": "tsc -p jsconfig.json --watch",
    "prepublishOnly": "git diff --quiet HEAD && test -z \"$(git status --porcelain)\" || (echo 'fob-lgr: commit or stash first; refusing to publish a dirty tree' && exit 1)"
  },
  "keywords": [
    "ledger",
    "double-entry",
    "accounting",
    "api-client",
    "cli",
    "finops",
    "finopsbricks"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "commander": "^15.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/node": "^22.20.1",
    "jest": "^29.7.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
